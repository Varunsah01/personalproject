# Outreach sender configuration — copy to .env.outreach and fill in values
# NEVER commit the real .env.outreach file

# Gmail inboxes for rotation (up to 5)
# For each: ADDRESS is the Gmail address, TOKEN_PATH is the OAuth token
# created by setup_gmail_oauth.py (stored in secrets/)
OUTREACH_INBOX_1_ADDRESS=          # e.g. varun.outreach1@gmail.com
OUTREACH_INBOX_1_TOKEN_PATH=       # e.g. secrets/varun.outreach1@gmail.com.token.json

OUTREACH_INBOX_2_ADDRESS=
OUTREACH_INBOX_2_TOKEN_PATH=

OUTREACH_INBOX_3_ADDRESS=
OUTREACH_INBOX_3_TOKEN_PATH=

OUTREACH_INBOX_4_ADDRESS=
OUTREACH_INBOX_4_TOKEN_PATH=

OUTREACH_INBOX_5_ADDRESS=
OUTREACH_INBOX_5_TOKEN_PATH=

# Daily send caps (GUARDRAILS §1.7 hard ceiling: 25)
OUTREACH_DAILY_CAP_GLOBAL=25       # Total across all inboxes
OUTREACH_DAILY_CAP_PER_INBOX=25    # Per single inbox

# Apollo.io — free tier (50 credits/month)
# Get your key at https://app.apollo.io/#/settings/integrations/api
APOLLO_API_KEY=

# Hunter.io — free tier (50 verifications/month)
# Get your key at https://hunter.io/api-keys
HUNTER_API_KEY=

# Mobile push notifications via ntfy.sh (free, no account needed)
# 1. Install the ntfy app: https://ntfy.sh (Android/iOS)
# 2. Subscribe to a random unguessable topic string (e.g. varun-outreach-a8f3k2)
# 3. Paste that topic string below
NTFY_TOPIC=
