# job-bot credentials — copy to .env and fill in values
# NEVER commit the real .env file

# Platform credentials
NAUKRI_EMAIL=          # Naukri.com login email
NAUKRI_PASSWORD=       # Naukri.com login password
NAUKRI_CURRENT_CTC=    # Optional: current CTC for Naukri forms (leave empty to skip)
NAUKRI_EXPECTED_CTC=   # Optional: expected CTC for Naukri forms (leave empty to skip)
LINKEDIN_EMAIL=        # LinkedIn login email
LINKEDIN_PASSWORD=     # LinkedIn login password
WELLFOUND_EMAIL=       # Wellfound (AngelList) login email
WELLFOUND_PASSWORD=    # Wellfound login password
CUTSHORT_EMAIL=        # Cutshort login email
CUTSHORT_PASSWORD=     # Cutshort login password
INSTAHYRE_EMAIL=       # Instahyre login email
INSTAHYRE_PASSWORD=    # Instahyre login password
INSTAHYRE_CURRENT_CTC= # Optional: current CTC for Instahyre forms
INSTAHYRE_EXPECTED_CTC= # Optional: expected CTC for Instahyre forms

# Global daily cap (total applications across all platforms)
DAILY_CAP_GLOBAL=300

# Per-platform soft ceilings (anti-rate-limit guardrails)
DAILY_CAP_NAUKRI_CEILING=100
DAILY_CAP_LINKEDIN_CEILING=100
DAILY_CAP_WELLFOUND_CEILING=100
DAILY_CAP_CUTSHORT_CEILING=100
DAILY_CAP_GREENHOUSE_CEILING=80
DAILY_CAP_INSTAHYRE_CEILING=100

# File paths for CSV logs
LOG_FILE=data/applications_log.csv
SUMMARY_FILE=data/daily_summary.csv

# Browser settings
HEADLESS=true          # Run Playwright in headless mode
DRY_RUN=false          # Score and log without clicking Apply

# Greenhouse platform (platforms/greenhouse.py)
GREENHOUSE_EMAIL=              # Email for Greenhouse application forms (falls back to NAUKRI_EMAIL)
GREENHOUSE_HEAR_ABOUT=Personal referral / network  # Default answer for "How did you hear?"

# Relevance agent (core/relevance_agent.py)
ANTHROPIC_API_KEY=             # Required for LLM relevance agent; omit to disable
RELEVANCE_MODEL=claude-sonnet-4-6  # Model for relevance checks (default: claude-sonnet-4-6)
MAX_RELEVANCE_API_CALLS_PER_DAY=400  # Hard budget; falls back to keyword scorer when exceeded

# Optional: daily digest email (build step 9)
SMTP_HOST=             # e.g. smtp.gmail.com
SMTP_PORT=587          # TLS port
SMTP_USER=             # SMTP login
SMTP_PASSWORD=         # SMTP password or app-specific password
DIGEST_TO=varunsah@yahoo.com  # Recipient for the 7 PM digest
