# job-bot credentials — copy to .env and fill in values
# NEVER commit the real .env file

# Platform credentials
NAUKRI_EMAIL=
NAUKRI_PASSWORD=
LINKEDIN_EMAIL=
LINKEDIN_PASSWORD=
WELLFOUND_EMAIL=
WELLFOUND_PASSWORD=
CUTSHORT_EMAIL=
CUTSHORT_PASSWORD=

# Daily caps per platform
DAILY_CAP_NAUKRI=75
DAILY_CAP_LINKEDIN=40
DAILY_CAP_WELLFOUND=30
DAILY_CAP_CUTSHORT=25

# File paths
LOG_FILE=data/applications_log.csv
SUMMARY_FILE=data/daily_summary.csv

# Browser settings
HEADLESS=true
DRY_RUN=false

# Optional: daily digest email
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
DIGEST_TO=varunsah@yahoo.com
